{% style %}
  .custom-banner-bg{
    {% if section.settings.background_img_desktop != blank %}
        background-image: url({{ section.settings.background_img_desktop | img_url: 'master' }}) !important;
    {% endif %}
  }
  .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media only screen and (max-width: 767px) {
    .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    .custom-banner-bg{
        {% if section.settings.background_img_mob != blank %}
            background-image: url({{ section.settings.background_img_mob | img_url: 'master' }}) !important;
        {% else %}
            background-image: url({{ section.settings.background_img_desktop | img_url: 'master' }}) !important;
        {% endif %}
    }
  }
{% endstyle %}

<section id="custom-banner" class="color-{{ section.settings.color_scheme }} custom-banner-bg">
  <div class="page-width">
      <div class="banner-content section-{{ section.id }}-padding">
            {%- if section.setting.sub-heading -%}
                <h5 class="banner-subheaidng">{{ section.settings.sub-heading }}</h5>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
                <h1>{{ section.settings.heading }}</h1>
            {%- endif -%}
            {%- if section.settings.desc != blank -%}
                <div class="banner-desc">{{ section.settings.desc }}</div>
            {%- endif -%}

            {%- if section.settings.btn_text != blank -%}
                <div class="banner-button-wrap banner-button-wrap--desktop">
                {%- if section.settings.btn_text != blank -%}
                    <a
                    href="{% if section.settings.btn_link != blank %}{{ section.settings.btn_link }}{% else %}#{% endif %}"
                    class="button button--primary banner-cta"
                    >
                    {{ section.settings.btn_text | escape }}
                    </a>
                {%- endif -%}
                </div>
            {%- endif -%}
        </div>
    </div>

</section>

{% schema %}
{
  "name": "Custom Banner",
  "tag": "section",
  "class": "section-custom-banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_img_desktop",
      "label": "Add Banner Background [Desktop]"
    },
    {
      "type": "image_picker",
      "id": "background_img_mob",
      "label": "Add Banner Background [Mobile]"
    },
    {
        "type": "text",
        "id": "sub-heading",
        "label": "Add subheading"
    },
    {
        "type": "text",
        "id": "heading",
        "label": "Add Heading"
    },
    {
        "type": "richtext",
        "id": "desc",
        "label": "Add Description"
    },
    {
        "type": "text",
        "id": "btn_text",
        "label": "Add Button Text"
    },
    {
        "type": "url",
        "id": "btn_link",
        "label": "Add Button Link"
    },
    {
      "type": "image_picker",
      "id": "hero_banner_img",
      "label": "Select Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Custom Banner",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
