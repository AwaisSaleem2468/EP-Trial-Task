{% comment %}
  Custom featured product card for tabbed slider.

  Accepts:
  - product: {Object} Product
  - tab_id: {String}
  - discount_percent: {Number}
  - button_label: {String}
  - show_rating: {Boolean}
  - image_bg: {String}
  - subscribe_selling_plan_id: {String} optional fallback selling plan ID

  Product metafields used:
  - custom.product_rating (decimal)
  - custom.product_rating_stars (integer)

  Subscribe uses selling plan + SUBSCRIBE25 discount code.
{% endcomment %}
{%- liquid
  assign card_product = product
  assign variant = card_product.selected_or_first_available_variant
  assign onetime_price = variant.price
  assign compare_at = variant.compare_at_price
  assign subscribe_price = onetime_price

  if discount_percent > 0
    assign save_cents = onetime_price | times: discount_percent | divided_by: 100
    assign subscribe_price = onetime_price | minus: save_cents
  endif

  if settings.currency_code_enabled
    assign money_onetime = onetime_price | money_with_currency
    assign money_subscribe = subscribe_price | money_with_currency
    if compare_at > onetime_price
      assign money_compare = compare_at | money_with_currency
    endif
  else
    assign money_onetime = onetime_price | money
    assign money_subscribe = subscribe_price | money
    if compare_at > onetime_price
      assign money_compare = compare_at | money
    endif
  endif

  assign rating_value = blank
  assign rating_scale = 5
  assign rating_stars = blank
  assign show_rating_row = false

  if card_product.metafields.custom.product_rating != blank
    assign rating_value = card_product.metafields.custom.product_rating.value
  endif

  if card_product.metafields.custom.product_rating_stars != blank
    assign rating_stars = card_product.metafields.custom.product_rating_stars.value | plus: 0
  elsif rating_value != blank
    assign rating_stars = rating_value | round
    if rating_stars > rating_scale
      assign rating_stars = rating_scale
    endif
  endif

  if rating_stars != blank
    if rating_stars > rating_scale
      assign rating_stars = rating_scale
    endif
    if rating_stars < 0
      assign rating_stars = 0
    endif
  endif

  if show_rating
    if rating_value != blank or rating_stars != blank
      assign show_rating_row = true
    endif
  endif

  assign media_bg = image_bg | default: '#E8DFD4'
  assign image_alt = card_product.title
  if card_product.featured_media != blank and card_product.featured_media.alt != blank
    assign image_alt = card_product.featured_media.alt
  endif

  assign card_selling_plan_id = subscribe_selling_plan_id | default: blank
  if card_product.selling_plan_groups.size > 0
    for group in card_product.selling_plan_groups
      for plan in group.selling_plans
        assign plan_name = plan.name | downcase
        if plan_name contains 'subscribe' or plan_name contains 'subscription' or plan_name contains 'autoship' or plan_name contains 'save'
          assign card_selling_plan_id = plan.id
          break
        endif
      endfor
    endfor
    if card_selling_plan_id == blank
      assign card_selling_plan_id = card_product.selling_plan_groups.first.selling_plans.first.id
    endif
  endif
-%}

<article
  class="custom-featured__card"
  data-ep-card
  data-tab="{{ tab_id | escape }}"
  data-variant-id="{{ variant.id }}"
  data-available="{{ variant.available }}"
  {% if card_selling_plan_id != blank %}data-selling-plan-id="{{ card_selling_plan_id }}"{% endif %}
>
  <a
    class="custom-featured__card-media"
    href="{{ card_product.url }}"
    style="--card-media-bg: {{ media_bg }};"
    aria-label="{{ card_product.title | escape }}"
  >
    {%- if card_product.featured_media != blank -%}
      {{
        card_product.featured_media
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          widths: '240, 360, 480, 640, 800',
          sizes: '(max-width: 768px) 65vw, (min-width: 991px) 22vw, 33vw',
          class: 'custom-featured__card-image',
          alt: image_alt
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'custom-featured__card-image placeholder-svg' }}
    {%- endif -%}
  </a>

  <div class="custom-featured__card-body">
    <h3 class="custom-featured__card-title">
      <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
    </h3>

    {%- if show_rating_row -%}
      <div
        class="custom-featured__rating"
        aria-label="{% if rating_value != blank %}Rated {{ rating_value }} out of {{ rating_scale }}{% endif %}"
      >
        {%- if rating_stars != blank -%}
          <span class="custom-featured__stars" aria-hidden="true">
            {%- for i in (1..rating_scale) -%}
              <svg
                class="custom-featured__star{% if i > rating_stars %} custom-featured__star--empty{% endif %}"
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill="currentColor"
                focusable="false"
              >
                <path d="M7 0.5l1.76 3.57 3.94.57-2.85 2.78.67 3.92L7 9.5l-3.52 1.84.67-3.92L1.3 4.64l3.94-.57L7 .5z"/>
              </svg>
            {%- endfor -%}
          </span>
        {%- endif -%}

        {%- if rating_value != blank -%}
          <span class="custom-featured__rating-value">{{ rating_value }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div
      class="custom-featured__price"
      data-ep-price
      data-onetime="{{ money_onetime | escape }}"
      data-subscribe="{{ money_subscribe | escape }}"
      data-compare="{% if money_compare %}{{ money_compare | escape }}{% endif %}"
      data-compare-onetime="{% if money_compare %}{{ money_compare | escape }}{% elsif onetime_price > subscribe_price %}{{ money_onetime | escape }}{% endif %}"
    >
      <span class="custom-featured__price-current" data-ep-price-current>{{ money_subscribe }}</span>
      <span
        class="custom-featured__price-compare{% unless money_compare or onetime_price > subscribe_price %} hidden{% endunless %}"
        data-ep-price-compare
      >
        {%- if money_compare -%}
          {{ money_compare }}
        {%- elsif onetime_price > subscribe_price -%}
          {{ money_onetime }}
        {%- endif -%}
      </span>
    </div>

    <button
      type="button"
      class="custom-featured__atc"
      data-ep-atc
      {% unless variant.available %}disabled{% endunless %}
    >
      <span data-ep-atc-label>
        {%- if variant.available -%}
          {{ button_label | escape }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
      <span class="custom-featured__atc-spinner hidden" aria-hidden="true"></span>
    </button>
  </div>
</article>
